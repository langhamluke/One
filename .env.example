# Copy to .env (never commit .env). In production, load these from your host's
# secrets vault instead of a file.

# Use a RESTRICTED key (rk_test_... / rk_live_...) from a Stripe sandbox while
# developing. Required permissions are listed in docs/STRIPE_INTEGRATION_PLAN.md.
STRIPE_SECRET_KEY=rk_test_replace_me

# Signing secret for your webhook endpoint (whsec_...). For local dev, the
# Stripe CLI prints one when you run:
#   stripe listen --forward-to localhost:4242/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL of the storefront; Checkout redirects back here.
PUBLIC_BASE_URL=https://slopecycleski.com

# Comma-separated ISO country codes you ship rental gear to. Leave empty if
# gear is only picked up in person (no shipping address is collected then).
SHIP_TO_COUNTRIES=US

# Set to true only after adding a Terms of Service URL in
# Dashboard → Settings → Public details; Checkout rejects sessions otherwise.
REQUIRE_TERMS_OF_SERVICE=false

PORT=4242
