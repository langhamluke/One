{
  "name": "slopecycle-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Stripe Payments integration for Slopecycle seasonal kids' ski apparel rentals",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "seed:catalog": "tsx --env-file=.env scripts/seed-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langhamluke/One.git"
  },
  "dependencies": {
    "express": "^4.22.3",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
