#!/bin/sh
# Blocks commits that contain Stripe API keys or webhook signing secrets.
# Enable with: npm run hooks:install
pattern='(sk|rk)_(test|live)_[A-Za-z0-9]{10,}|whsec_[A-Za-z0-9]{10,}'
if git diff --cached -U0 --no-color | grep '^+' | grep -Eq "$pattern"; then
  echo "pre-commit: staged changes contain what looks like a Stripe secret. Remove it and use .env or a secrets vault." >&2
  exit 1
fi
