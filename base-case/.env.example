# ---- Base Case / Flight Plan server configuration ----
# Which product this instance serves: base-case (new graduates) or flight-plan (airline pilots).
# One codebase, one build; the product sets the name, phase labels, questionnaire wording, demo personas and defaults.
PRODUCT=base-case
# Port for the API server (the Vite dev server proxies /api here).
PORT=8787
# Public origin of the app (used for CSRF origin checks and invite links).
APP_ORIGIN=http://localhost:5173

# Database. Leave DATABASE_URL empty to use the embedded PGlite database stored in ./data/pg (zero setup).
# For production, point at Postgres (Neon, Supabase, RDS, Railway...): postgres://user:pass@host:5432/basecase
DATABASE_URL=

# 32-byte master key (hex, 64 chars) for AES-256-GCM encryption of client plan data at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BASE_CASE_MASTER_KEY=

# Session cookie signing secret (any long random string).
SESSION_SECRET=

# Optional: Anthropic API key for the in-app assistant. Without it the assistant runs in offline explainer mode.
ANTHROPIC_API_KEY=
# Optional: model for the assistant (default claude-opus-5-5).
BASE_CASE_CHAT_MODEL=claude-opus-5-5

# Optional: firm display name shown in the UI and on the printed summary (defaults to the product name).
FIRM_NAME=
# Optional: bootstrap admin on first start (only used when the users table is empty).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set to 1 to load demo personas and demo accounts on first start (local demos only).
DEMO_SEED=1
