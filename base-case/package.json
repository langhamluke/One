{
  "name": "base-case",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base Case: a secure, role-based financial planning platform for new graduates (client, advisor, admin).",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "create-admin": "tsx server/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@electric-sql/pglite": "0.3.16",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hono/node-server": "1.19.18",
    "drizzle-orm": "0.45.4",
    "framer-motion": "11.18.2",
    "hono": "4.13.16",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "tsx": "4.23.15",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "concurrently": "9.2.5",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
