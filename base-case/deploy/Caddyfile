# Caddy obtains and renews a Let's Encrypt certificate for {$DOMAIN} automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8787
	# Security headers (CSP, HSTS, frame denial, no-sniff) are set by the app itself.
	log {
		output stdout
		format json
	}
}

# Extra products on the same droplet (Flight Plan, Sprout): one site file each, written by deploy/setup-flight-plan.sh / setup-sprout.sh.
# A glob that matches nothing is fine.
import /etc/caddy/sites/*.caddy
